# Local shop (ticket #37) -- see shop/README.md.
#
# Secret shared between the WooCommerce `order.updated` webhook and whatever
# verifies its X-WC-Webhook-Signature header (the future webhook receiver,
# #39). `npm run shop:up` reads this when (re)creating the webhook; if unset
# it defaults to "test-secret", which is fine for purely local use.
WOOCOMMERCE_WEBHOOK_SECRET=test-secret

# Override only if you are not using the default local capture listener
# (npm run shop:capture, which listens on port 3000 and is reachable from
# wp-env's containers at http://host.docker.internal:3000).
# WOOCOMMERCE_WEBHOOK_URL=http://host.docker.internal:3000/api/webhooks/woocommerce

# The deliver module (ticket #41, src/deliver/README.md) -- a thin wrapper
# over the WooCommerce REST API. `npm run shop:up` creates a REST API key
# and writes these three to a gitignored .env.shop.local at the repo root;
# copy them from there when running the worker locally outside `npm run
# shop:*` (e.g. `PUBQUIZ_WORKER=1 npm run dev`). No default: all three are
# required for the worker to reach the shop.
# WOOCOMMERCE_URL=http://localhost:45330
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
