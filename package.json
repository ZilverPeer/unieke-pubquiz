{
  "name": "unieke-pubquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "announcements:generate": "tsx scripts/announcements/generate.ts",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/repository/database.types.ts",
    "generate": "tsx src/scripts/generate.ts",
    "shop:up": "wp-env start && tsx scripts/shop/setup.ts",
    "shop:down": "wp-env stop && (docker stop pubquiz-mailpit || exit 0)",
    "shop:order": "tsx scripts/shop/place-order.ts",
    "shop:capture": "tsx scripts/shop/capture-webhook.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.115.0",
    "ffmpeg-static": "^5.3.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@wordpress/env": "^11.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fast-check": "^4.9.0",
    "msedge-tts": "^2.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.0"
  }
}
